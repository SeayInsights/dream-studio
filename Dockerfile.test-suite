# The full test suite, in an environment that matches CI.
#
# WHY THIS EXISTS. `pytest tests/` cannot complete on Windows: a conftest guard aborts the
# session when a test writes to the operator's real ~/.dream-studio/events, and it fires
# around 2,400 of 5,928 collected (WO efe2ce9d). So the only place the whole suite ran was
# CI's ubuntu full-ci — post-merge, which is where #687 turned main red after a green
# 3-platform matrix. This image closes that gap locally.
#
# WHAT IT HAS TO CARRY, learned by getting it wrong first. Dockerfile.runtime-check has no
# git binary and .dockerignore excludes .git, so a first run produced 89 failures and 20
# errors that were entirely environmental — tests that need commit history, a working tree,
# or a checkout to reason about. An environment that differs from CI does not verify
# anything; it just produces a different set of numbers.
#
# The repo is MOUNTED rather than copied, so .git comes with it and the run grades the tree
# you are actually holding.
#
#   docker build -f Dockerfile.test-suite -t ds-suite .
#   docker run --rm -v "$PWD":/workspace ds-suite
#
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp/ds-user \
    DREAM_STUDIO_HOME=/tmp/ds-home

# git is not optional: a large part of the suite reads commit history, and without the
# binary those tests fail for a reason that says nothing about the code.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN mkdir -p "$HOME" "$DREAM_STUDIO_HOME"

COPY requirements.txt requirements-dev.txt pyproject.toml ./
RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-dev.txt

# A mounted repo is owned by the host user; git refuses to operate on a tree it does not
# trust, and that refusal would look exactly like the missing-binary failure above.
RUN git config --global --add safe.directory /workspace

CMD ["python", "-m", "pytest", "tests/", "-q"]
